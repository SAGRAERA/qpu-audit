# ---------------------------------------------------------------------------
# qpu-audit credentials — TEMPLATE
#
#   ##  Do not put real values in this file.  ##
#   This file is committed to the repository. Real values go in .env only.
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in .env
# 3. .env is git-ignored. Never commit it.
#
# Real environment variables take precedence over .env
# ---------------------------------------------------------------------------

# IBM Cloud API key.
#   Create at: https://cloud.ibm.com/iam/apikeys
#   Note: the key inherits the IAM permissions of the identity that created it.
#         There is no way to attach permissions to a key directly.
IBM_QUANTUM_API_KEY=

# CRN of your Qiskit Runtime service instance.
#   IBM Quantum Platform console -> Instances -> select instance -> copy CRN
#   Format: crn:v1:bluemix:public:quantum-computing:<region>:a/<account>:<instance>::
#   The account ID is read from this value, so nothing else needs configuring.
IBM_QUANTUM_CRN=

# ---------------------------------------------------------------------------
# Optional. Defaults are used when left unset.
# ---------------------------------------------------------------------------

# API base URL
# IBM_QUANTUM_BASE_URL=https://quantum.cloud.ibm.com/api

# IBM-API-Version header
# IBM_QUANTUM_API_VERSION=2025-05-01

# Auth mode: apikey | iam
#   apikey = Authorization: apikey <KEY>       (default, recommended)
#   iam    = exchange for an IAM bearer token  (used automatically on 401)
# IBM_QUANTUM_AUTH_MODE=apikey

# IAM token endpoint (only used when auth_mode=iam)
# IBM_IAM_URL=https://iam.cloud.ibm.com/identity/token
